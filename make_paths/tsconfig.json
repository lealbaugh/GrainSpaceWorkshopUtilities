{
  "compilerOptions": {
    "target": "ES2020",
    "outDir": "./dist",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "archive",
    "dist"
  ]
}
